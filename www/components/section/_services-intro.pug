include ../breadcrumb/_breadcrumb
include ../counter/_counter

// Intro
section.section.section-sm.section-layer.pb-1( data-preset!={ title:'Intro', category:'counter', reload:true, id:'intro-16' } )
	.bg-layer.bg-image.novi-background( style='bottom: 13.6%; background-image: url(images/services-01-1920x772.jpg);' )
	.container
		.context-dark
			+breadcrumb( breadcrumbs )
			.row.row-offset-xl.novi-disabled
				.col-lg-8.col-xl-7.col-xxl-9
