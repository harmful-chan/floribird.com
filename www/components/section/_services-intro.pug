					h5 We are not afraid of difficult tasks –
						| #[br.d-none.d-xs-block]
						| hundreds of our satisfied clients can prove that.
		.row.row-30( style='margin-top: 10.6%;' )
			.col-6.col-xs-5.col-md-4.col-lg-3
				+counter({
					value: 1255,
					title: 'Satisfied customers'
				}).counter-boxed
			.col-6.col-xs-5.col-md-4.col-lg-3
				+counter({
					value: 935,
					title: 'Locks installed'
				}).counter-boxed.counter-boxed-primary-gradient
