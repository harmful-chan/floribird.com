include ../logo/_logo
include ../rights/_rights

// Footer app
footer.section.footer.footer-lg.bg-transparent.novi-background( data-preset!={ title:'Footer App', category:'footer', reload:true, id:'footer-app' } )
	.container
		.row.row-40.row-md-50.justify-content-md-between.justify-content-xl-end
			.col-lg-4.col-xl-3
				+logo
				p.small At Introl, we provide leading security solutions for home & business. From surveillance to alarms, our products will help you stay protected and safe.
			.col-auto.col-xs-4.col-lg-auto.col-xl-3
				h6 What we do
				ul.list.list-xl.small.font-weight-normal
					li.list-item: a.list-link( href='#' ) Home & office security
					li.list-item: a.list-link( href='#' ) Data protection
					li.list-item: a.list-link( href='#' ) Alarm installation
					li.list-item: a.list-link( href='#' ) Internet security
					li.list-item: a.list-link( href='#' ) Access control service
					li.list-item: a.list-link( href='#' ) Fire protection services
			.col-auto.col-xs-4.col-lg-auto.col-xl-3
				h6 Get in touch at
				
				ul.list.list-xl.small.font-weight-normal
					li.list-item: a.list-link( href='mailto:#' ) mail@demolink.org
			.col-auto.col-xs-4.col-lg-auto.col-xl-3
				h6 Contact info
				ul.list.list-xl.small.font-weight-normal
					li.list-item Mon-Fri: 8am - 6pm
					li.list-item Sat-Sun: 8am - 4pm
					li.list-item Holidays: closed
			.col-sm-7.col-lg-6.col-xl-5
				h6 Discover the latest news & updates
				form.rd-mailform( data-form-output='form-output-footer-app', data-form-type='subscribe', method='post', action='components/rd-mailform/rd-mailform.php' )
					.form-group-icon.novi-disabled
						input.form-control( type='email', name='email', placeholder='Enter your email address', data-constraints='@Email @Required' )
						button.form-group-icon-btn.int-arrow-right.novi-icon
				#form-output-footer-app.form-output.snackbar.snackbar-dark
			.col-sm-5.col-xl-3.offset-lg-1.align-self-end.pb-sm-3
				.group-30.d-flex.text-900
					a.icon.icon-xs.icon-social.int-youtube.novi-icon( href='#' )
					a.icon.icon-xs.icon-social.int-facebook.novi-icon( href='#' )
					a.icon.icon-xs.icon-social.int-instagram.novi-icon( href='#' )
					a.icon.icon-xs.icon-social.int-twitter.novi-icon( href='#' )
					a.icon.icon-xs.icon-social.int-linkedin.novi-icon( href='#' )

		hr.divider.divider-sm.footer-divider

		.footer-panel
			+rights
