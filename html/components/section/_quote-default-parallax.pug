include ../quote/_quote

// Quote default parallax
section.section.section-lg.section-boxed.context-dark.novi-background.bg-image( style='background-image: url( images/home-05-1840x605.jpg )', data-preset!={ title:'Quote Default Parallax', category:'quote, parallax', reload:true, id:'quote-default-parallax' } )
	.container
		.row.row-40.row-md-50
			.col-sm-6.col-lg-4
				+quote({
					rating:   true,
					text:     quote1.text,
					img:      'persons/person-01-64x64',
					name:     quote1.name,
					position: quote1.position
				})
			.col-sm-6.col-lg-4
				+quote({
					rating:   true,
					text:     quote2.text,
